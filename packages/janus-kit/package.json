{
	"name": "@nxgt/janus-kit",
	"version": "0.1.3",
	"description": "@nxgt/janus wired in one call, one subpath per database — PostgreSQL through Drizzle, MongoDB — with sessions in Redis, telemetry, a health check and a close",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		"./drizzle": {
			"types": "./dist/drizzle/index.d.ts",
			"import": "./dist/drizzle/index.js",
			"default": "./dist/drizzle/index.js"
		},
		"./mongo": {
			"types": "./dist/mongo/index.d.ts",
			"import": "./dist/mongo/index.js",
			"default": "./dist/mongo/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"identity",
		"authentication",
		"authorization",
		"postgresql",
		"redis",
		"janus",
		"typescript",
		"mongodb"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-janus.git",
		"directory": "packages/janus-kit"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/drizzle/index.ts",
			"src/mongo/index.ts"
		]
	},
	"dependencies": {
		"@nxgt/janus-redis": "workspace:^"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.8",
		"@nxgt/drizzle": "0.6.1",
		"@nxgt/janus": "workspace:^",
		"@nxgt/janus-drizzle": "workspace:^",
		"@nxgt/janus-mongo": "workspace:^",
		"@nxgt/janus-telemetry": "workspace:^",
		"@nxgt/mongo": "^0.17.1",
		"@nxgt/redis": "0.3.1",
		"@nxgt/telemetry": "0.2.1",
		"@types/bun": "^1.4.2",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"mongodb": "^7.6.0",
		"mongodb-memory-server-core": "11.2.0",
		"redis-memory-server": "0.17.1",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@nxgt/drizzle": ">=0.6.1 <1",
		"@nxgt/janus": "workspace:^",
		"@nxgt/janus-drizzle": "workspace:^",
		"@nxgt/janus-mongo": "workspace:^",
		"@nxgt/janus-telemetry": "workspace:^",
		"@nxgt/mongo": ">=0.17.0 <1",
		"@nxgt/redis": ">=0.3.1 <1",
		"drizzle-orm": ">=1.0.0-rc.4 <2",
		"mongodb": ">=7.0.0 <8",
		"typescript": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"@nxgt/drizzle": {
			"optional": true
		},
		"@nxgt/janus-drizzle": {
			"optional": true
		},
		"@nxgt/janus-mongo": {
			"optional": true
		},
		"@nxgt/janus-telemetry": {
			"optional": true
		},
		"@nxgt/mongo": {
			"optional": true
		},
		"drizzle-orm": {
			"optional": true
		},
		"mongodb": {
			"optional": true
		}
	}
}
