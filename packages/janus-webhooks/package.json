{
	"name": "@nxgt/janus-webhooks",
	"version": "0.0.0",
	"private": true,
	"description": "Signed webhooks for @nxgt/janus user events: Standard Webhooks signatures, retries with backoff, rotating secrets, and deliveries that run out reported — never dropped in silence",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"identity",
		"authentication",
		"webhooks",
		"standard-webhooks",
		"janus",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-janus.git",
		"directory": "packages/janus-webhooks"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@nxgt/janus": "workspace:^",
		"@types/bun": "^1.4.2",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@nxgt/janus": "workspace:^",
		"typescript": "^6.0.3"
	}
}
