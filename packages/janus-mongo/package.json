{
	"name": "@nxgt/janus-mongo",
	"version": "0.0.0",
	"private": true,
	"description": "The MongoDB adapter for @nxgt/janus: users, sessions and one-time tokens",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"identity",
		"authentication",
		"mongodb",
		"janus",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-janus.git",
		"directory": "packages/janus-mongo"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@nxgt/janus": "workspace:^",
		"@nxgt/mongo": "^0.17.1",
		"@types/bun": "^1.4.2",
		"mongodb": "^7.6.0",
		"mongodb-memory-server-core": "11.2.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@nxgt/janus": "workspace:^",
		"@nxgt/mongo": ">=0.17.0 <1",
		"mongodb": ">=7.0.0 <8",
		"typescript": "^6.0.3",
		"zod": ">=4.6.5 <5"
	}
}
